# Copy to .env for Docker Compose. Do not put secrets in this example.
# Use 127.0.0.1 when only a reverse proxy on the Docker host should connect.
BIND_ADDRESS=0.0.0.0
HTTP_PORT=8000

# Optional reachable origin for classroom links (no path, query or fragment).
# LAN example: http://192.168.1.100:8000
# HTTPS example: https://clab.example.com
# Empty: links use the URL opened in the browser; teachers should not use
# localhost when sharing with other devices.
PUBLIC_ORIGIN=
